{
  "$schema": "https://schema.railpack.com",
  "provider": "php",
  "packages": {
    "node": "24"
  },
  "steps": {
    "prepare": {
      "commands": ["...", "rm -f /app/public/index.php"]
    },
    "extensions": {
      "commands": ["...", "install-php-extensions pdo_pgsql redis zip"]
    },
    "install:composer": {
      "variables": {
        "COMPOSER_NO_DEV": "1"
      }
    },
    "build": {
      "commands": [
        "...",
        { "src": "public/index.php", "dest": "/app/public/index.php" },
        "grep -Fq LARAVEL_START /app/public/index.php",
        "php artisan config:clear"
      ]
    }
  },
  "deploy": {
    "variables": {
      "PORT": "80",
      "DB_CONNECTION": "pgsql",
      "REDIS_CLIENT": "phpredis",
      "CACHE_STORE": "redis",
      "SESSION_DRIVER": "redis",
      "QUEUE_CONNECTION": "sync"
    }
  }
}
